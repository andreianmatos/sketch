{
  "name": "bussaco-latent-archive",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "vectorize": "python3 generate/extract_strokes.py --limit 0",
    "dictionary": "python3 generate/build_style_dictionary.py",
    "pens": "PYTHONPATH=. python3 generate/build_pens.py",
    "strokes": "npm run vectorize && npm run dictionary && npm run pens",
    "prepare": "npm run strokes",
    "train-strokes": "PYTHONPATH=. python3 generate/stroke_model/train.py --epochs 40",
    "icons": "PYTHONPATH=. python3 generate/extract_icons.py",
    "train-flower": "PYTHONPATH=. python3 generate/extract_icons.py --label flower && PYTHONPATH=. python3 generate/stroke_model/train.py --icon flower --epochs 60",
    "model": "PYTHONPATH=. python3 generate/server.py"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "p5": "^1.11.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "@types/p5": "^1.7.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.14",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
